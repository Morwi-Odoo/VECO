<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_dashboard_kanban_xunnel" model="ir.ui.view">
        <field name="name">Xunnel accountant dashboard</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='dashboard_bank_cash_right']" position="inside">
                <div invisible="online_journal_last_sync == False" class="row" name="last_synchronization">
                    <div class="col-xs-6">
                        <span title="Latest synchronization">Xunnel Last sync</span>
                    </div>
                    <div class="col-xs-6 text-right">
                        <span>
                            <field name="online_journal_last_sync" />
                        </span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="account_journal_dashboard_inherit_online_sync_id" model="ir.ui.view">
        <field name="name">Xunnel accountant dashboard</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account_online_synchronization.account_journal_dashboard_inherit_online_sync" />
        <field name="arch" type="xml">
            <xpath expr="//a[@name='manual_sync']" position="before">
                <div class="mb8">
                    <field name="has_synchronized_xunnel"  invisible="True"/>
                    <field name="account_online_link_id"  invisible="True"/>
                    <small class="text-danger" invisible="account_online_link_id == False or has_synchronized_xunnel == True">Online synchronization may duplicate the transactions added manually.</small>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
