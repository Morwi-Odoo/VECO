<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="cce_view_invoice_line_tree" model="ir.ui.view">
            <field name="name">cce.account.invoice.line.tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
               <xpath expr="/form/sheet/notebook/page[1]/field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                   <field name="info_mercancias" force_save="1" column_invisible="parent.l10n_mx_edi_external_trade_type not in ('02', '03')"/>
                 </xpath>
               <xpath expr="/form/sheet/notebook/page[@id='aml_tab']/field[@name='line_ids']/list/field[@name='name']" position="after">
                   <field name="info_mercancias" force_save="1" column_invisible="parent.l10n_mx_edi_external_trade_type not in ('02', '03')"/>
                 </xpath>
            </field>
        </record>

</odoo>
